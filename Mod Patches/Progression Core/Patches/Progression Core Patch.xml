<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- NOTE: This will need to be done in C#, because lateral thinking is made a prerequisite for other research projects via C# -->

    <!-- 1. Disconnect lateral thinking from anything in the game -->

    <!-- Prerequisites for Researches -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef/prerequisites/li[text()="RR_LateralThinking"]</xpath>

        <match Class="PatchOperationRemove">
            <xpath>/Defs/ResearchProjectDef/prerequisites/li[text()="RR_LateralThinking"]</xpath>
        </match>
    </Operation>

    <!-- Prerequisites for Things -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef/researchPrerequisites/li[text()="RR_LateralThinking"]</xpath>

        <match Class="PatchOperationRemove">
            <xpath>/Defs/ThingDef/researchPrerequisites/li[text()="RR_LateralThinking"]</xpath>
        </match>
    </Operation>

    <!-- Prerequisites for Recipes -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/RecipeDef/researchPrerequisites/li[text()="RR_LateralThinking"]</xpath>

        <match Class="PatchOperationRemove">
            <xpath>/Defs/RecipeDef/researchPrerequisites/li[text()="RR_LateralThinking"]</xpath>
        </match>
    </Operation>

    <!-- 2. Delete lateral thinking -->
    <!-- <Operation Class="PatchOperationRemove">
        <xpath>Defs/ResearchProjectDef[defName="RR_LateralThinking"]</xpath>
    </Operation> -->


</Patch>