                        <researchPrerequisites>
                            <li>RR_IncendiaryWeapons</li>
                            <li>CE_Launchers</li>
                        </researchPrerequisites>
                    </value>
                </li>                
            </operations>
        </nomatch>
    </Operation>
</Patch>