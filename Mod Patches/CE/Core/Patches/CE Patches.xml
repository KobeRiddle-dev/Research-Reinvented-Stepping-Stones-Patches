        <xpath>Defs/ThingDef[defName="CE_FlareGun"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisites>
                <li>Gunsmithing</li>
                <li>RR_IncendiaryWeapons</li>
            </researchPrerequisites>
        </value>
    </Operation>

