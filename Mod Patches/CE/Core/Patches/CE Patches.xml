    <!-- Conditional patches active only when "The Generic Ammo Experience for Combat Extended" is NOT loaded -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>The Generic Ammo Experience for Combat Extended</li>
        </mods>
        <nomatch Class="PatchOperationSequence">
            <operations>
                <!-- Adds research prerequisites to Incendiary Launcher Grenades -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/RecipeDef[defName="MakeAmmo_LauncherGrenade_Incendiary"]</xpath>
                    <value>
                        <researchPrerequisites Inherit="False">
                            <li>RR_IncendiaryWeapons</li>
                            <li>CE_AdvancedAmmo</li>
                        </researchPrerequisites>
                    </value>
                </li>

                <!-- Adds research prerequisites to Incendiary Autocannon Shells -->
